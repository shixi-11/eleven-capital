{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/主頁（home）", "destination": "/", "permanent": true },
    { "source": "/關於我們（about-us）", "destination": "/#about", "permanent": true },
    { "source": "/核心團隊（core-team）", "destination": "/#founder", "permanent": true },
    { "source": "/合作夥伴（partner）", "destination": "/#partners", "permanent": true }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
